# Flask
# Zufallswert erzeugen: python -c "import secrets; print(secrets.token_hex(32))"
# Bleibt der Platzhalter stehen, nutzt die App einen Zufallsschlüssel (Sitzungen enden bei Neustart).
SECRET_KEY=change-me-to-a-random-value
# DATABASE_URL=sqlite:////pfad/zur/app.db   # optional, sonst instance/app.db
# SESSION_COOKIE_SECURE=true                # hinter HTTPS setzen
# DISPLAY_TIMEZONE=Europe/Berlin            # Zeitzone für angezeigte Importzeiten

# Erst-Admin: wird nur angelegt, solange es noch keinen Benutzer gibt. Danach entfernen.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional/später (LDAP ist aktuell nicht angebunden):
# LDAP_SERVER=ldap://ucs.schule.local
# LDAP_USE_SSL=false
# LDAP_BASE_DN=dc=schule,dc=local
# LDAP_USER_DN_TEMPLATE={username}@schule.local
# LDAP_TEACHER_GROUP_DN=cn=Lehrer,cn=groups,dc=schule,dc=local

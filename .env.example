# Flask
SECRET_KEY=change-me-to-a-random-value
# DATABASE_URL=sqlite:////pfad/zur/app.db   # optional, sonst instance/app.db

# LDAP / UCS-AD
LDAP_SERVER=ldap://ucs.schule.local
LDAP_USE_SSL=false
LDAP_BASE_DN=dc=schule,dc=local
# Platzhalter {username} wird durch den eingegebenen Login-Namen ersetzt.
LDAP_USER_DN_TEMPLATE={username}@schule.local
LDAP_TEACHER_GROUP_DN=cn=Lehrer,cn=groups,dc=schule,dc=local
